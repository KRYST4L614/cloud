# Optional overrides for the local GitLab stack. Not application/VPS secrets.
GITLAB_IMAGE=gitlab/gitlab-ce:19.5.3-ce.0
RUNNER_IMAGE=gitlab/gitlab-runner:alpine-v19.5.0
# Use the LAN interface address if GitLab should also be reachable from another PC.
GITLAB_BIND_ADDRESS=127.0.0.1
# Separate from the application's 100.100.0.0/24; avoids private ranges routed by VPN.
GITLAB_SUBNET=100.100.1.0/24
