# Copy to .env and replace the example credentials before deployment.
# MongoDB credentials are initialized when the database volume is first created.
MONGO_USER=cloud
MONGO_PASSWORD=cloudpass
# Shared credentials for the backend S3 client and the VersityGW WebUI.
S3_ACCESS_KEY=cloudadmin
S3_SECRET_KEY=cloudsecret123
# Bucket containing application-managed file objects.
S3_BUCKET=cloud-files
# Replace example secrets before deployment; keep these three secrets independent.
JWT_SECRET=please-change-this-jwt-secret
ALERT_WEBHOOK_TOKEN=please-change-this-webhook-token
S3_EVENT_TOKEN=please-change-this-event-token
# Per-user quota for newly registered accounts: 1 GiB, expressed in bytes.
USER_QUOTA_BYTES=1073741824
# Maximum size of one uploaded file: 512 MiB, expressed in bytes.
MAX_UPLOAD_BYTES=536870912
# Initial Grafana administrator credentials; application users are managed separately.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
